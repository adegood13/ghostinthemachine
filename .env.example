# Ghost in the Machine - environment variables
# Copy this file to `.env` for local development and paste the real values.
# In Netlify, set these under Site settings -> Environment variables.

# Transistor RSS feed URL for the podcast. Replace with the real feed once
# Transistor is set up. The RSS feed is parsed at build time and powers the
# episode list, individual episode pages, and feed.xml.
PUBLIC_PODCAST_RSS_URL=https://feeds.transistor.fm/ghost-in-the-machine

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to
# disable analytics during local development.
PUBLIC_GA4_ID=

# Beehiiv embed URL for the newsletter signup form. Get this from Beehiiv ->
# Settings -> Embed -> Inline form. Leave blank to hide the signup until set.
PUBLIC_BEEHIIV_EMBED_URL=

# YouTube channel URL. Used on the Watch page.
PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@Ghostinthemachine-c5v

# LinkedIn page URL. Used on the Watch page.
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/ghose-in-the-machine/

# Instagram URL. Used in the footer and contact page.
PUBLIC_INSTAGRAM_URL=https://www.instagram.com/ghostinthemachinepodcast/

# Optional: current live YouTube video ID. When set, the home and watch pages
# render the live embed. Leaving it blank renders the "next episode" card
# instead. The src/config/live.ts file is the source of truth; this env var
# is an override for quick toggles without a code change.
PUBLIC_LIVE_YOUTUBE_VIDEO_ID=
