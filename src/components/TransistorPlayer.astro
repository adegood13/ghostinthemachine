---
import type { PodcastEpisode } from '@/lib/rss';

export interface Props {
  episode: PodcastEpisode;
}

const { episode } = Astro.props;
---

{episode.transistorEmbedUrl ? (
  <iframe
    src={episode.transistorEmbedUrl}
    class="w-full"
    width="100%"
    height="180"
    frameborder="0"
    scrolling="no"
    seamless
    title={`Listen to ${episode.title}`}
    loading="lazy"
  ></iframe>
) : episode.audioUrl ? (
  <div class="card p-4">
    <audio controls preload="none" class="w-full" src={episode.audioUrl}>
      Your browser does not support the audio element.
      <a href={episode.audioUrl}>Download the episode.</a>
    </audio>
  </div>
) : (
  <div class="card p-5 text-sm text-circuit-silver">
    Audio for this episode is not available in the feed. Check back once the
    Transistor RSS feed has been connected.
  </div>
)}
