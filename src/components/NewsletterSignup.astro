---
import { siteConfig } from '@/config/site';

const beehiivUrl = import.meta.env.PUBLIC_BEEHIIV_EMBED_URL;
---

<section class="card p-8 md:p-10">
  <div class="grid gap-6 md:grid-cols-[1.2fr_1fr] md:gap-10 items-start">
    <div>
      <span class="eyebrow">Newsletter</span>
      <h2 class="mt-2 font-display font-extrabold tracking-tight text-2xl md:text-3xl text-balance">
        {siteConfig.newsletter.heading}
      </h2>
      <p class="mt-3 max-w-prose text-circuit-silver leading-relaxed">
        {siteConfig.newsletter.blurb}
      </p>
    </div>
    <div>
      {beehiivUrl ? (
        <iframe
          src={beehiivUrl}
          class="w-full min-h-[200px] bg-transparent"
          style="border: 0;"
          title="Newsletter signup"
          loading="lazy"
        ></iframe>
      ) : (
        <form
          class="space-y-3"
          action="#"
          data-beehiiv-placeholder
          aria-describedby="beehiiv-note"
        >
          <label class="block">
            <span class="sr-only">Email address</span>
            <input
              type="email"
              required
              placeholder="you@domain.com"
              class="w-full bg-transparent border border-ghost-white/30 px-4 py-3 text-base placeholder:text-circuit-silver focus:border-static-teal focus:outline-none"
            />
          </label>
          <button type="submit" class="btn-primary w-full">Subscribe</button>
          <p id="beehiiv-note" class="text-xs text-circuit-silver">
            Set <code class="text-ghost-white">PUBLIC_BEEHIIV_EMBED_URL</code> to replace this placeholder with the live Beehiiv form.
          </p>
        </form>
      )}
    </div>
  </div>
</section>
