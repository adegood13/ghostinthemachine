---
// Minimal inline SVG icons for podcast platforms. No external dependencies,
// no icon-font runtime, no raster assets. The class prop lets callers set
// size and color.
export interface Props {
  icon: string;
  class?: string;
}

const { icon, class: className = 'h-5 w-5' } = Astro.props;
