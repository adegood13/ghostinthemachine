---
import { siteConfig } from '@/config/site';
import PlatformIcon from './PlatformIcon.astro';

export interface Props {
  heading?: string | null;
  variant?: 'compact' | 'full';
}

const { heading = 'Where to listen', variant = 'compact' } = Astro.props;
---

<section class="py-6">
  {heading && (
    <h2 class:list={['font-display font-extrabold tracking-tight mb-6', variant === 'full' ? 'text-display-md' : 'text-2xl']}>
      {heading}
    </h2>
  )}
  <ul class:list={['grid gap-3', variant === 'full' ? 'grid-cols-2 md:grid-cols-3 lg:grid-cols-4' : 'grid-cols-2 sm:grid-cols-3 md:grid-cols-4']}>
    {siteConfig.platforms.map((p) => (
      <li>
        <a
          href={p.url}
          rel={p.url.startsWith('http') ? 'noopener' : undefined}
          target={p.url.startsWith('http') ? '_blank' : undefined}
          class="card flex items-center gap-3 p-4 hover:border-static-teal"
        >
          <PlatformIcon icon={p.icon} class="h-5 w-5 text-static-teal" />
          <span class="font-semibold">{p.name}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
