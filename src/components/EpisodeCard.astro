---
import type { PodcastEpisode } from '@/lib/rss';

export interface Props {
  episode: PodcastEpisode;
  variant?: 'default' | 'feature';
}

const { episode, variant = 'default' } = Astro.props;

const pubDate = episode.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const href = `/episodes/${episode.slug}`;
const isFeature = variant === 'feature';
---

<article class:list={['card group', isFeature ? 'p-8 md:p-10' : 'p-5']}>
  <a href={href} class="block focus:outline-none">
    <div class:list={['grid gap-6', isFeature ? 'md:grid-cols-[280px_1fr] md:gap-10' : 'grid-cols-[96px_1fr] sm:grid-cols-[120px_1fr]']}>
      <div class:list={['relative overflow-hidden', isFeature ? 'aspect-square max-w-[280px]' : 'aspect-square']}>
        <img
          src={episode.artwork}
          alt=""
          loading={isFeature ? 'eager' : 'lazy'}
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      </div>
      <div class="flex flex-col justify-between">
        <div>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-circuit-silver">
            {episode.episodeNumber != null && (
              <span class="eyebrow">Ep. {episode.episodeNumber}</span>
            )}
            <span>{pubDate}</span>
            {episode.duration && <span>· {episode.duration}</span>}
          </div>
          <h3 class:list={[
            'mt-2 font-display font-extrabold tracking-tight text-ghost-white group-hover:text-static-teal transition-colors',
            isFeature ? 'text-2xl md:text-3xl' : 'text-base sm:text-lg',
          ]}>
            {episode.title}
          </h3>
          {episode.guest && (
            <p class="mt-1 text-sm text-circuit-silver">with <span class="text-ghost-white">{episode.guest}</span></p>
          )}
          {isFeature && (
            <p class="mt-4 text-sm md:text-base text-ghost-white/80 leading-relaxed line-clamp-4">
              {episode.description}
            </p>
          )}
        </div>
        {isFeature && (
          <div class="mt-6 flex items-center gap-2 text-static-teal text-sm font-medium uppercase tracking-[0.14em]">
            <span>Listen to episode</span>
            <span aria-hidden="true">&rarr;</span>
          </div>
        )}
      </div>
    </div>
  </a>
</article>
