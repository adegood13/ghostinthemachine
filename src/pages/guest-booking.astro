---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { bookingUrl, bookingPasswordHash, bookingIntro } from '@/config/booking';
---

<BaseLayout
  title="Guest booking"
  description="Private guest booking page."
  noindex={true}
>
  <section class="container-site pt-16 md:pt-24 pb-16 min-h-[70vh]">
    <!-- PASSWORD GATE -->
    <div data-booking-gate>
      <div class="max-w-md">
        <span class="eyebrow">Private</span>
        <h1 class="mt-4 text-display-md uppercase text-balance">Approved guests only.</h1>
        <p class="mt-4 text-circuit-silver leading-relaxed">
          This page is for confirmed guests of the show. Enter the access password you were given to see open recording dates.
        </p>
        <form class="mt-6 space-y-3" data-booking-form>
          <label class="block">
            <span class="sr-only">Access password</span>
            <input
              type="password"
              name="booking-password"
              required
              autocomplete="off"
              placeholder="Access password"
              class="w-full bg-transparent border border-ghost-white/30 px-4 py-3 text-base placeholder:text-circuit-silver focus:border-static-teal focus:outline-none"
            />
          </label>
          <button type="submit" class="btn-primary w-full">Unlock</button>
          <p class="text-sm text-red-400 hidden" data-booking-error>
            That password is not right. Check it and try again.
          </p>
        </form>
        <p class="mt-6 text-xs text-circuit-silver">
          Not a confirmed guest yet? Suggest yourself or someone else on the
          <a class="text-static-teal link-hover" href="/submit">guest submission form</a>.
        </p>
      </div>
    </div>

    <!-- BOOKING CONTENT (revealed after the gate) -->
    <div data-booking-content hidden>
      <div class="max-w-prose">
        <span class="eyebrow">{bookingIntro.eyebrow}</span>
        <h1 class="mt-4 text-display-md uppercase text-balance">{bookingIntro.heading}</h1>
        <p class="mt-4 text-circuit-silver leading-relaxed">{bookingIntro.blurb}</p>
      </div>

      <div class="mt-10">
        {bookingUrl ? (
          <div
            data-booking-widget
            style="min-width: 320px; min-height: 700px;"
          ></div>
        ) : (
          <div class="card p-8 md:p-10">
            <span class="eyebrow">Setup pending</span>
            <h2 class="mt-2 font-display font-extrabold tracking-tight text-2xl">
              The scheduler is not connected yet.
            </h2>
            <p class="mt-3 text-circuit-silver max-w-prose">
              Set the <code class="text-ghost-white">PUBLIC_BOOKING_URL</code> environment variable in Netlify to the Calendly link and the scheduler will load here.
            </p>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ bookingPasswordHash, bookingUrl }}>
  const gate = document.querySelector('[data-booking-gate]');
  const content = document.querySelector('[data-booking-content]');
  const form = document.querySelector('[data-booking-form]');
  const errorEl = document.querySelector('[data-booking-error]');

  const STORAGE_KEY = 'gitm-booking-unlocked';
  let schedulerLoaded = false;

  async function sha256(text) {
    const data = new TextEncoder().encode(text);
    const digest = await crypto.subtle.digest('SHA-256', data);
    return Array.from(new Uint8Array(digest))
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('');
  }

  function loadCalendlyAssets() {
    return new Promise((resolve) => {
      if (window.Calendly) {
        resolve();
        return;
      }
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = 'https://assets.calendly.com/assets/external/widget.css';
      document.head.appendChild(css);

      const script = document.createElement('script');
      script.src = 'https://assets.calendly.com/assets/external/widget.js';
      script.async = true;
      script.onload = () => resolve();
      document.head.appendChild(script);
    });
  }

  // Mount the Calendly widget only after the gate is passed, so the
  // booking URL is not requested for anyone who never unlocks the page.
  async function mountScheduler() {
    const widget = document.querySelector('[data-booking-widget]');
    if (!widget || !bookingUrl || schedulerLoaded) return;
    schedulerLoaded = true;
    await loadCalendlyAssets();
    if (window.Calendly) {
      window.Calendly.initInlineWidget({
        url: bookingUrl,
        parentElement: widget,
        // Brand-matched colours (a paid Calendly feature).
        pageSettings: {
          backgroundColor: '0A0A0A',
          textColor: 'F5F5F5',
          primaryColor: '7A9BA8',
        },
      });
    }
  }

  function reveal() {
    if (gate) gate.hidden = true;
    if (content) content.hidden = false;
    mountScheduler();
  }

  // Stay unlocked for the rest of the browser session.
  try {
    if (sessionStorage.getItem(STORAGE_KEY) === '1') reveal();
  } catch (e) {}

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = form.querySelector('input[name="booking-password"]');
    const value = input ? input.value.trim() : '';
    const hash = await sha256(value);
    if (hash === bookingPasswordHash) {
      try { sessionStorage.setItem(STORAGE_KEY, '1'); } catch (e) {}
      if (errorEl) errorEl.classList.add('hidden');
      reveal();
    } else {
      if (errorEl) errorEl.classList.remove('hidden');
      if (input) {
        input.value = '';
        input.focus();
      }
    }
  });
</script>
