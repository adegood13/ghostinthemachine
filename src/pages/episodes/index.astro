---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EpisodeSearch from '@/components/EpisodeSearch.tsx';
import NewsletterSignup from '@/components/NewsletterSignup.astro';
import { loadFeed } from '@/lib/rss';
import { siteConfig } from '@/config/site';
import { liveConfig } from '@/config/live';

const feed = await loadFeed();
const hasEpisodes = feed.episodes.length > 0;
const episodesLite = feed.episodes.map((e) => ({
  slug: e.slug,
  title: e.title,
  description: e.description,
  guest: e.guest,
  artwork: e.artwork,
  pubDateISO: e.pubDateISO,
  duration: e.duration,
  episodeNumber: e.episodeNumber,
  season: e.season,
}));

const premiereDate = liveConfig.nextEpisodeDate
  ? new Date(liveConfig.nextEpisodeDate)
  : null;
const premiereLabel = premiereDate
  ? premiereDate.toLocaleDateString('en-US', {
      weekday: 'long',
      month: 'long',
      day: 'numeric',
      timeZone: 'America/New_York',
    })
  : null;
const premiereTime = premiereDate
  ? premiereDate.toLocaleTimeString('en-US', {
      hour: 'numeric',
      minute: '2-digit',
      timeZoneName: 'short',
      timeZone: 'America/New_York',
    })
  : null;
---

<BaseLayout
  title="Episodes"
  description={`Every episode of ${siteConfig.name}. Search by title, guest, or topic.`}
>
  <section class="container-site pt-16 md:pt-24 pb-6">
    <span class="eyebrow">{hasEpisodes ? 'Archive' : 'Coming soon'}</span>
    <h1 class="mt-4 text-display-lg uppercase text-balance">
      {hasEpisodes ? 'All episodes' : 'The first episode is on the way.'}
    </h1>
    <p class="mt-6 max-w-prose text-lg text-circuit-silver leading-relaxed">
      {hasEpisodes
        ? `The full archive. Filter by season, search by guest or topic, or just scroll. New drops every ${siteConfig.schedule.liveDay}.`
        : 'Once the show is live, every episode lands here, searchable by title, guest, or topic.'}
    </p>
  </section>

  {hasEpisodes ? (
    <section class="container-site py-8">
      <EpisodeSearch client:load episodes={episodesLite} />
    </section>
  ) : (
    <section class="container-site py-8">
      <div class="card p-8 md:p-12">
        <span class="eyebrow">Premiere</span>
        <h2 class="mt-2 font-display font-extrabold tracking-tight text-2xl md:text-3xl text-balance">
          {premiereLabel ? `${premiereLabel} at ${premiereTime}` : `Premiering this ${siteConfig.schedule.liveDay}`}
        </h2>
        <p class="mt-3 max-w-prose text-circuit-silver leading-relaxed">
          Episode 1: Andrew and Liz on why we built this show, why it matters, and why now. No guest, no script. Just the two of us laying out what the next year of the podcast is going to be.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/watch" class="btn-primary">Watch the premiere</a>
          <a href="/listen" class="btn-ghost">Subscribe in advance</a>
        </div>
      </div>
    </section>
  )}

  <section class="container-site py-12">
    <NewsletterSignup />
  </section>
</BaseLayout>
