---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Submission received" description="Thanks for your guest submission.">
  <section class="container-site pt-20 md:pt-28 pb-16">
    <span class="eyebrow">Received</span>
    <h1 class="mt-4 text-display-lg uppercase text-balance">Got it. Thank you.</h1>
    <p class="mt-6 max-w-prose text-lg text-circuit-silver leading-relaxed">
      We read every guest submission. If your suggestion is a fit for an upcoming episode, we will reach out. If not, we still appreciate you taking the time. We do not book quickly, but we do book thoughtfully.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Back home</a>
      <a href="/episodes" class="btn-ghost">Browse episodes</a>
    </div>
  </section>
</BaseLayout>
