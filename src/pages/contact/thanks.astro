---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Message received" description="Thanks for reaching out.">
  <section class="container-site pt-20 md:pt-28 pb-16">
    <span class="eyebrow">Received</span>
    <h1 class="mt-4 text-display-lg uppercase text-balance">Thanks. We will be in touch.</h1>
    <p class="mt-6 max-w-prose text-lg text-circuit-silver leading-relaxed">
      Your message is in the inbox. We reply to sponsorship and press notes first. Audience questions show up on future episodes when they are worth a whole segment.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Back home</a>
      <a href="/episodes" class="btn-ghost">Browse episodes</a>
    </div>
  </section>
</BaseLayout>
