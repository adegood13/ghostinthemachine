---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
---

<BaseLayout title="Contact" description="Sponsorship, press, or audience questions for Ghost in the Machine.">
  <section class="container-site pt-16 md:pt-24 pb-8">
    <span class="eyebrow">Contact</span>
    <h1 class="mt-4 text-display-lg uppercase text-balance">Talk to us.</h1>
    <p class="mt-6 max-w-prose text-lg text-circuit-silver leading-relaxed">
      Sponsorships, press, audience questions for the show, or just a note. This form goes straight to the inbox we actually read. For guest suggestions, use the <a class="text-static-teal link-hover" href="/submit">guest submission form</a> instead.
    </p>
  </section>

  <section class="container-site py-8 pb-16 grid gap-10 md:grid-cols-[1.3fr_1fr]">
    <form
      name="contact"
      method="POST"
      action="/contact/thanks"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="card p-6 md:p-10 space-y-6"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden">
        <label>Leave this field empty: <input name="bot-field" /></label>
      </p>

      <label class="block">
        <span class="block mb-2 text-sm font-medium">Name <span class="text-static-teal">*</span></span>
        <input type="text" name="name" required class="w-full bg-transparent border border-ghost-white/30 px-4 py-3 placeholder:text-circuit-silver focus:border-static-teal focus:outline-none" />
      </label>

      <label class="block">
        <span class="block mb-2 text-sm font-medium">Email <span class="text-static-teal">*</span></span>
        <input type="email" name="email" required class="w-full bg-transparent border border-ghost-white/30 px-4 py-3 placeholder:text-circuit-silver focus:border-static-teal focus:outline-none" />
      </label>

      <label class="block">
        <span class="block mb-2 text-sm font-medium">Topic</span>
        <select name="topic" class="w-full bg-signal-black border border-ghost-white/30 px-4 py-3 focus:border-static-teal focus:outline-none">
          <option value="general">General</option>
          <option value="sponsorship">Sponsorship</option>
          <option value="press">Press</option>
          <option value="question">Audience question for the show</option>
        </select>
      </label>

      <label class="block">
        <span class="block mb-2 text-sm font-medium">Message <span class="text-static-teal">*</span></span>
        <textarea name="message" required rows="6" class="w-full bg-transparent border border-ghost-white/30 px-4 py-3 placeholder:text-circuit-silver focus:border-static-teal focus:outline-none"></textarea>
      </label>

      <button type="submit" class="btn-primary">Send message</button>
    </form>

    <aside class="space-y-4">
      <div class="card p-6">
        <span class="eyebrow">Email</span>
        <p class="mt-2">
          <a class="text-static-teal link-hover text-lg" href={`mailto:${siteConfig.social.email}`}>
            {siteConfig.social.email}
          </a>
        </p>
      </div>
      <div class="card p-6">
        <span class="eyebrow">Social</span>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="link-hover" href={siteConfig.social.youtube} target="_blank" rel="noopener">YouTube</a></li>
          <li><a class="link-hover" href={siteConfig.social.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a class="link-hover" href={siteConfig.social.instagram} target="_blank" rel="noopener">Instagram</a></li>
        </ul>
      </div>
    </aside>
  </section>
</BaseLayout>
